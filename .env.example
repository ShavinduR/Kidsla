# Public, non-secret config (safe to commit). Override per-environment in Vercel → Settings → Environment Variables.
# Your live site URL — no trailing slash. Used for Open Graph link previews. CHANGE THIS to your real domain.
VITE_SITE_URL=https://kidsla.vercel.app
# Meta Pixel ID (Events Manager → Data sources). Leave empty to disable.
VITE_META_PIXEL_ID=

# ---- SERVER-ONLY SECRETS (admin login) ----
# Set these in Vercel → Settings → Environment Variables. NEVER prefix with VITE_ (that would publish them).
# For local dev put them in .env.local (git-ignored).
# ADMIN_PASSWORD=choose-a-long-password
# ADMIN_SESSION_SECRET=   # generate: openssl rand -hex 32
# MongoDB Atlas connection string (server-only). Without it the shop uses the bundled catalogue.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=kidsla

# ---- Phase 1 (server-only unless prefixed VITE_) ----
# CRON_SECRET=          # random string; Vercel sends it to /api/cron/expire-orders
# RESEND_API_KEY=       # email alerts (resend.com)
# ALERT_EMAIL_TO=you@example.com
# ALERT_EMAIL_FROM=     # optional, after verifying your domain in Resend
# VITE_SENTRY_DSN=      # optional front-end error tracking (sentry.io)

# ---- Phase 2 ----
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME   # photo uploads (server-only)

# ---- Phase 3 ----
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=   # generated in PayHere FOR YOUR DOMAIN (server-only)
# PAYHERE_MODE=sandbox       # or live
