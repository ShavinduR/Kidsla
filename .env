# Public, non-secret config (safe to commit). Override per-environment in Vercel → Settings → Environment Variables.
# Your live site URL — no trailing slash. Used for Open Graph link previews. CHANGE THIS to your real domain.
VITE_SITE_URL=https://kidsla.vercel.app
# Meta Pixel ID (Events Manager → Data sources). Leave empty to disable.
VITE_META_PIXEL_ID=
